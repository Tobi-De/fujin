# Systemd service for health
# Learn more: https://www.freedesktop.org/software/systemd/man/systemd.service.html

[Unit]
Description=bookstore health check
After=network.target

[Service]
Type=oneshot
User=bookstore
Group=bookstore
WorkingDirectory=/opt/fujin/bookstore
EnvironmentFile=/opt/fujin/bookstore/current/.env

# Main command - adjust to match your application
ExecStart=/opt/fujin/bookstore/current/venv/bin/bookstore health

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/fujin/bookstore
