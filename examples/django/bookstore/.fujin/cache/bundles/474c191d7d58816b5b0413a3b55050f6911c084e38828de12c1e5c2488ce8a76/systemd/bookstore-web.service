# Systemd service for web
# Learn more: https://www.freedesktop.org/software/systemd/man/systemd.service.html

[Unit]
Description=bookstore web
After=network.target
# Add dependencies if needed:
# Requires=postgresql.service
# After=postgresql.service

[Service]
Type=simple
User=bookstore
Group=bookstore
WorkingDirectory=/opt/fujin/bookstore
EnvironmentFile=/opt/fujin/bookstore/current/.env
RuntimeDirectory=bookstore
RuntimeDirectoryMode=0755
# Create sockets/files as group-writable so Caddy can access them
UMask=0002

# PermissionsStartOnly=true
ExecStartPre=/opt/fujin/bookstore/current/venv/bin/bookstore collectstatic --no-input
ExecStartPre=/opt/fujin/bookstore/current/venv/bin/bookstore migrate
ExecStart=/opt/fujin/bookstore/current/venv/bin/gunicorn bookstore.wsgi:application --bind unix:/run/bookstore/bookstore.sock --access-logfile - --error-logfile -

# Restart policy
Restart=on-failure
RestartSec=5s

# Resource limits (uncomment to enable)
# MemoryMax=512M
# CPUQuota=50%

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/fujin/bookstore
ReadWritePaths=/run/bookstore

[Install]
WantedBy=multi-user.target
