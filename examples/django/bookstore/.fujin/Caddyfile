# Caddyfile for {app_name}
# Learn more: https://caddyserver.com/docs/caddyfile

net.oluwatobi.dev {

    # Serve static files
    handle_path /static/* {
        root * {app_dir}/shared/staticfiles
        file_server
    }

    # Proxy to web service
    reverse_proxy unix//run/bookstore/bookstore.sock
}

